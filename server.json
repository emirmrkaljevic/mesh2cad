  "name": "io.github.emirmrkaljevic/mesh2cad",
  "description": "Mesh (STL/OBJ/PLY) to editable STEP, CadQuery or OpenSCAD: primitive fitting, fidelity report",
  "repository": {"url": "https://github.com/emirmrkaljevic/mesh2cad", "source": "github"},
  "version": "0.8.0",
